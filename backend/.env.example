SECRET_KEY=change-this-in-production
# Local MongoDB default. For MongoDB Atlas, replace this with your mongodb+srv:// URI.
MONGO_URI=mongodb://127.0.0.1:27017/
DATABASE_NAME=ThreatDetectionDB
MONGO_DB=ThreatDetectionDB
REQUIRE_MONGODB=False
AUTO_SEED_MONGODB=True
FORCE_SEED_MONGODB=False
MONGO_SERVER_SELECTION_TIMEOUT_MS=5000
DEBUG=True
MODEL_VERSION=IF_SHARED_V2
CORS_ORIGINS=http://localhost:5173
